# ========================================
# SeguroPro / Opportunizze
# Exemplo de Variáveis de Ambiente
# ========================================

# Database (PostgreSQL)
DATABASE_URL=postgresql://usuario:senha@localhost:5432/seguropro
PGHOST=localhost
PGPORT=5432
PGUSER=seguropro
PGPASSWORD=sua_senha_aqui
PGDATABASE=seguropro

# Session
SESSION_SECRET=sua_chave_secreta_muito_longa_aqui_minimo_32_caracteres

# Application
NODE_ENV=production
PORT=5000

# ========================================
# Para Docker Compose (opcional)
# ========================================
POSTGRES_DB=seguropro
POSTGRES_USER=seguropro
POSTGRES_PASSWORD=sua_senha_aqui
